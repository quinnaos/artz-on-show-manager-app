# Copy this file to .env.local for local development, and set the same
# values as Environment Variables in your Vercel project for production.

# Supabase project settings (Project Settings > API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The email address that becomes the first Owner the moment it signs in,
# before anyone has been added through the in-app admin screen.
OWNER_EMAIL=you@artzonshow.co.nz
